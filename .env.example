# Kit Email Marketing Integration
# Required for newsletter, subscriber management, and email automation.
# Get these from: https://app.kit.com/account/api_credentials

# Kit API Key (V4)
KIT_API_KEY=

# Kit Tag IDs (created in Kit by administrator, not dynamically)
# These tags must be created in Kit before use
KIT_WEBSITE_SUBSCRIBER_TAG_ID=
KIT_HOMEPAGE_SIGNUP_TAG_ID=
KIT_ESTIMATE_REQUEST_TAG_ID=
KIT_GUIDE_DOWNLOAD_TAG_ID=
KIT_REVIEWER_TAG_ID=

# Kit Sequence ID (created in Kit by administrator, not dynamically)
# This sequence must be created in Kit before use
KIT_WELCOME_SEQUENCE_ID=

# Google Workspace Integration
# Required for Gmail estimate emails, OAuth consent, and all Google APIs.
# Get these from: https://console.cloud.google.com/apis/credentials

# OAuth 2.0 Client ID (from Credentials page)
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret (from Credentials page)
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI (must match Authorized redirect URI in console)
# For local dev: http://localhost:3000/api/auth/google/callback
# For production: https://your-domain.vercel.app/api/auth/google/callback
# NOTE: Set this in Vercel environment variables for production deployment
GOOGLE_REDIRECT_URI=

# Vercel automatically sets VERCEL_URL in production
# This is used as a fallback for OAuth redirect URI if GOOGLE_REDIRECT_URI is not set
# Do not set this manually - it is automatically provided by Vercel

# Refresh token (obtained once via GET /api/auth/google)
# See: src/app/api/auth/google/route.ts
GOOGLE_REFRESH_TOKEN=

# Gmail: where estimate emails are sent
ESTIMATE_TO_EMAIL=taylor@happyplacecarpentry.com

# --- Future (not required for initial activation) ---

# Google Cloud Project ID
GOOGLE_PROJECT_ID=

# Google Drive folder ID (for photo/document storage)
GOOGLE_DRIVE_FOLDER_ID=

# Google API key (for Places API, Maps, etc.)
GOOGLE_API_KEY=

# Google Place ID (for review collection)
GOOGLE_PLACE_ID=

# Google Sheets: where reviews are stored (operational backend)
# Get this from: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
# Create a sheet named "Reviews" with headers matching the Review model
GOOGLE_REVIEWS_SHEET_ID=

# Upstash Redis Storage (CRITICAL - Required for production Drive ingestion and service card assignments)
# Required for Drive ingestion, media indexing, and service card runtime assignments
# Get these from: https://upstash.com/docs/redis/quickstart/nextjs
# PRODUCTION CONFIGURATION REQUIRED: Set these in Vercel project environment variables
# Without these, Drive ingestion will fail with 500 errors and service card assignments will not persist
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Encryption Key (CRITICAL - Required for Drive OAuth credential storage)
# Required for encrypting OAuth access/refresh tokens in Redis
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PRODUCTION CONFIGURATION REQUIRED: Set this in Vercel project environment variables
# Without this, Drive OAuth callback will fail when persisting authorization
ENCRYPTION_KEY=

# Vercel Blob Storage (CRITICAL - Required for production Drive ingestion)
# Required for Drive ingestion and media upload
# Get these from: https://vercel.com/docs/storage/vercel-blob/quickstart
# PRODUCTION CONFIGURATION REQUIRED: Set these in Vercel project environment variables
# Without this, Drive ingestion will fail with 500 errors
BLOB_READ_WRITE_TOKEN=

# Workbench Authentication (CRITICAL - Required for administrative access)
# Required for Workbench login and media management access
# Generate a secure password and set it in Vercel environment variables
# PRODUCTION CONFIGURATION REQUIRED: Set this in Vercel project environment variables
# Without this, Workbench login will fail and administrative features will be inaccessible
WORKBENCH_PASSWORD=

# GitHub Integration (Required for Workbench auto-commit to main)
# Required for Workbench acceptance to commit changes to main branch
# Get GITHUB_TOKEN from: https://github.com/settings/tokens
# PRODUCTION CONFIGURATION REQUIRED: Set these in Vercel project environment variables
# Without this, Workbench acceptance will persist changes but not commit to Git
GITHUB_TOKEN=
GITHUB_REPO_OWNER=trishnikitha-art
GITHUB_REPO_NAME=happy-place-platform

# Media Reconciliation Authorization (CRITICAL - Required for production repair operations)
# Required for explicit repair authorization in media reconciliation system
# This is the authorization token that must be provided to execute repair operations
# PRODUCTION CONFIGURATION REQUIRED: Set this in Vercel project environment variables
# Without this, repair operations will be rejected with 403 FORBIDDEN
# Generate a secure random UUID or similar token for this purpose
REPAIR_AUTHORIZATION_TOKEN=
